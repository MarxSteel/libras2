[Unit]
Description=libras2 Libras translation service
Documentation=https://github.com/MarxSteel/libras2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/libras2
Environment="PATH=/opt/libras2/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LIBRAS2_DATA_DIR=/opt/libras2/data/vlibrasil"
Environment="LIBRAS2_CACHE_DIR=/opt/libras2/data/cache"
Environment="LOG_LEVEL=INFO"
ExecStart=/opt/libras2/venv/bin/uvicorn service.main:app \
    --host 0.0.0.0 --port 8088 --workers 2 --no-access-log
Restart=always
RestartSec=3
MemoryMax=2G
CPUQuota=150%

# hardening básico
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/libras2/data

[Install]
WantedBy=multi-user.target
