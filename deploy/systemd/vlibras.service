[Unit]
Description=vlibras Libras translation service
Documentation=https://github.com/MarxSteel/vlibras
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vlibras
Environment="PATH=/opt/vlibras/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VLIBRAS_DATA_DIR=/opt/vlibras/data/vlibrasil"
Environment="VLIBRAS_CACHE_DIR=/opt/vlibras/data/cache"
Environment="LOG_LEVEL=INFO"
ExecStart=/opt/vlibras/venv/bin/uvicorn service.main:app \
    --host 127.0.0.1 --port 8088 --workers 2 --no-access-log
Restart=always
RestartSec=3
MemoryMax=2G
CPUQuota=150%

# hardening básico
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/vlibras/data

[Install]
WantedBy=multi-user.target
